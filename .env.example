# ==========================================
# Content Systems - Environment Configuration
# ==========================================

# Groq API Key (Recommended for ultra-fast Llama-3.3-70b inference)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (Fallback or primary alternative)
GEMINI_API_KEY=your_gemini_api_key_here


# Model Selection
# Options for Groq: llama-3.3-70b-versatile, qwen-2.5-32b, llama-3.1-8b-instant
PRIMARY_MODEL=llama-3.3-70b-versatile
FALLBACK_MODEL=gemini-2.5-flash
